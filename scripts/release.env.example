# Copy to /etc/star-share-release.env, fill values, then chmod 600.
# Never commit the populated production file.
EO_ZONE_ID="zone-your-edgeone-zone-id"
EO_STATIC_DOMAIN="starstaticfiles.niceaigc.com"

# Tencent Cloud credentials are stored by `tccli configure` in /root/.tccli.
# Normal releases do not purge EdgeOne: /starstatic files are content-hashed.
# Use scripts/purge-edgeone-static.sh only for a proven corrupt cached URL.

REPO_DIR="/opt/web/star_share_react"
RELEASE_ROOT="/opt/web/star_share_releases"
KEEP_RELEASES="10"
ASSET_RETENTION_DAYS="30"
