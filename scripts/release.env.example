# Copy to /etc/star-share-release.env, fill values, then chmod 600.
# Never commit the populated production file.
EO_ZONE_ID="zone-your-edgeone-zone-id"
EO_DOMAINS="niceaigc.net node1.nice188.com node2.nice188.com node3.nice188.com node4.nice188.com node5.nice188.com node6.nice188.com node7.nice188.com node8.nice188.com"

# Tencent Cloud credentials should normally be configured through `tccli configure`.
# If your tccli installation supports credential environment variables, export
# them from the root-readable production file instead of storing them here.

REPO_DIR="/opt/web/star_share_react"
RELEASE_ROOT="/opt/web/star_share_releases"
KEEP_RELEASES="10"
ASSET_RETENTION_DAYS="30"
